\NeedsTeXFormat{LaTeX2e}

\RequirePackage[table,dvipsnames]{xcolor}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage{graphicx}
\RequirePackage{pifont}
\RequirePackage{colortbl}
\RequirePackage{arydshln}

\definecolor{tbBest}{HTML}{FFD9DE}
\definecolor{tbSecond}{HTML}{D9EAF7}
\definecolor{tbThird}{HTML}{FFF2CC}
\definecolor{tbOurs}{HTML}{FFF3E0}
\definecolor{tbBase}{HTML}{F2F2F2}
\definecolor{tbGroup}{HTML}{EEEAF7}
\definecolor{tbGreenCell}{HTML}{E5F4EA}
\definecolor{tbBlueCell}{HTML}{E8F0F9}
\definecolor{tbPinkCell}{HTML}{F8DFE5}
\definecolor{tbAmberCell}{HTML}{FFF0CC}
\definecolor{tbVioletCell}{HTML}{EFE6FA}
\definecolor{tbHeatLow}{HTML}{EEF5FF}
\definecolor{tbHeatMid}{HTML}{D6EAF8}
\definecolor{tbHeatHigh}{HTML}{A9CCE3}
\definecolor{tbGain}{RGB}{0,122,75}
\definecolor{tbLoss}{RGB}{190,45,45}
\definecolor{tbNeutral}{gray}{0.55}
\definecolor{tbInk}{HTML}{202124}

\newcommand{\tbbest}[1]{\cellcolor{tbBest}\textbf{#1}}
\newcommand{\tbsecond}[1]{\cellcolor{tbSecond}\underline{#1}}
\newcommand{\tbthird}[1]{\cellcolor{tbThird}#1}
\newcommand{\tbgreencell}[1]{\cellcolor{tbGreenCell}#1}
\newcommand{\tbbluecell}[1]{\cellcolor{tbBlueCell}#1}
\newcommand{\tbpinkcell}[1]{\cellcolor{tbPinkCell}#1}
\newcommand{\tbambercell}[1]{\cellcolor{tbAmberCell}#1}
\newcommand{\tbvioletcell}[1]{\cellcolor{tbVioletCell}#1}
\newcommand{\tbheatlow}[1]{\cellcolor{tbHeatLow}#1}
\newcommand{\tbheatmid}[1]{\cellcolor{tbHeatMid}#1}
\newcommand{\tbheathigh}[1]{\cellcolor{tbHeatHigh}\textbf{#1}}

\newcommand{\tbpos}[1]{\textsubscript{\textcolor{tbGain}{$\uparrow$#1}}}
\newcommand{\tbneg}[1]{\textsubscript{\textcolor{tbLoss}{$\downarrow$#1}}}
\newcommand{\tbzero}[1]{\textsubscript{\textcolor{tbNeutral}{$\pm$#1}}}
\newcommand{\tbsig}{\textsuperscript{\textcolor{tbGain}{*}}}
\newcommand{\tbns}{\textsuperscript{\textcolor{tbNeutral}{n.s.}}}

\newcommand{\tbcheck}{\textcolor{tbGain}{\ding{51}}}
\newcommand{\tbxmark}{\textcolor{tbLoss}{\ding{55}}}
\newcommand{\tbpartial}{\textcolor{Orange}{\ding{108}}}

\newcommand{\tboursrow}{\rowcolor{tbOurs}}
\newcommand{\tbbaserow}{\rowcolor{tbBase}}
\newcommand{\tbgrouprow}{\rowcolor{tbGroup}}
\newcommand{\tbsection}[2]{\multicolumn{#1}{c}{\cellcolor{tbGroup}\textbf{#2}}\\}
\newcommand{\tbfamilyA}[1]{\cellcolor{tbGreenCell}#1}
\newcommand{\tbfamilyB}[1]{\cellcolor{tbBlueCell}#1}
\newcommand{\tbfamilyC}[1]{\cellcolor{tbPinkCell}#1}
\newcommand{\tbrankbadge}[2]{\raisebox{0.5pt}{\colorbox{#1}{\scriptsize\textbf{\textcolor{white}{~#2~}}}}}

\newcolumntype{Y}{>{\centering\arraybackslash}X}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}

\newcommand{\tbcompact}{%
  \small
  \setlength{\tabcolsep}{4pt}%
  \renewcommand{\arraystretch}{1.12}%
}
\newcommand{\tbwidecompact}{%
  \scriptsize
  \setlength{\tabcolsep}{3pt}%
  \renewcommand{\arraystretch}{1.08}%
}

